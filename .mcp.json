{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--browser",
        "chromium",
        "--headless",
        "--ignore-https-errors"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/tmp/pw-browsers"
      },
      "type": "stdio",
      "timeout": 60
    }
  }
}